# Local development values only. Replace these before exposing the stack.
APP_NAME="Risk Radar API"
APP_ENVIRONMENT=local

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=risk_radar
POSTGRES_USER=risk_radar
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_PUBLISHED_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change-me-redis
REDIS_PUBLISHED_PORT=6379

# MinIO object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=risk-radar
MINIO_SECURE=false
MINIO_API_PUBLISHED_PORT=9000
MINIO_CONSOLE_PUBLISHED_PORT=9001

# API
API_PUBLISHED_PORT=8000

# Discovery feeds (optional; connector reports unavailable when empty)
URLHAUS_AUTH_KEY=

# AI investigator & RAG grounded analysis (Stages 9 & 12)
# Supported LLM_PROVIDER values: apinex, claude, groq, openrouter, ollama (or empty for unavailable)
LLM_PROVIDER=apinex
LLM_MODEL=free/deepseek-v4-flash-0731
# Optional comma-separated fallback order when primary provider experiences outage or errors:
LLM_FALLBACK_PROVIDERS=claude

# APInex (Primary recommended free provider: https://api.apinex.bond/v1)
APINEX_API_KEY=
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=free/deepseek-v4-flash-0731

# Anthropic Claude
ANTHROPIC_API_KEY=

# Optional future providers:
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
